+/* ---- SM6375 UFS bring-up ---- */
+
+/*
+ * The SM6375 ABL leaves the host enabled with the UniPro link up (HCE=1,
+ * DP=1) and the clocks/PHY already running; only the transfer-list take-over
+ * below fails, because the controller needs a clean HCE re-execute first.
+ * Re-run HCE + DME link startup, then let ufs_take_over_host() reprogram the
+ * list. No clock/PHY re-init (re-initing them wrongly stalls the RCGs).
+ */
+#define REG_UIC_CMD		0x90
+#define REG_UIC_ARG1		0x94
+#define REG_UIC_ARG2		0x98
+#define REG_UIC_ARG3		0x9c
+
+#define HCS_UICRDY		(1u << 3)
+#define UIC_DME_LINK_STARTUP	0x16
+#define IS_UIC_CMD_COMPL	(1u << 10)
+
+static int
+sm6375_ufs_bringup(void)
+{
+	uint32_t res;
+	uint64_t deadline;
+
+	/* Polled driver: never drive the interrupt line. */
+	ufs_wr(REG_IE, 0);
+
+	/* HCE re-execute (ufshcd_hba_execute_hce). */
+	ufs_wr(REG_HCE, 0);
+	delay(1000);
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 2000 && !(ufs_rd(REG_HCE) & 1); i++) {
+		delay(50);
+	}
+	if (!(ufs_rd(REG_HCE) & 1)) {
+		panic("sm6375 ufs: HCE did not assert");
+	}
+	for (int i = 0; i < 2000 && !(ufs_rd(REG_HCS) & HCS_UICRDY); i++) {
+		delay(50);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_UICRDY)) {
+		panic("sm6375 ufs: UICRDY never asserted (hcs 0x%x)", ufs_rd(REG_HCS));
+	}
+
+	/* DME link startup (ufshcd_dme_link_startup). */
+	ufs_wr(REG_IS, IS_UIC_CMD_COMPL);
+	ufs_wr(REG_UIC_ARG1, 0);
+	ufs_wr(REG_UIC_ARG2, 0);
+	ufs_wr(REG_UIC_ARG3, 0);
+	ufs_wr(REG_UIC_CMD, UIC_DME_LINK_STARTUP);
+	nanoseconds_to_absolutetime(5ull * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	while (!(ufs_rd(REG_IS) & IS_UIC_CMD_COMPL)) {
+		if (mach_absolute_time() > deadline) {
+			panic("sm6375 ufs: DME link startup timed out (is 0x%x)", ufs_rd(REG_IS));
+		}
+		delay(1);
+	}
+	res = ufs_rd(REG_UIC_ARG2) & 0xff;
+	if (res != 0) {
+		panic("sm6375 ufs: DME link startup failed (res 0x%x)", res);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_DP)) {
+		panic("sm6375 ufs: no device present after link startup (hcs 0x%x)", ufs_rd(REG_HCS));
+	}
+
+	return 0;
+}
