+/* OnePlus Nord CE 3 Lite 5G, SM6375 "blair". Its UFS 3.1 host needs the full
+ * Qualcomm bring-up (GCC clocks + QMP v4-yupik PHY cal + HCE + link) before the
+ * transfer request list can be taken over; the naive path beryllium uses does
+ * not work there. */
+static inline bool
+sweet_board_sm6375(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("qcom,blair") ? 1 : 0;
+	}
+	return cached == 1;
+}
