+/* OnePlus Nord CE 3 Lite 5G, SM6375 "blair". Its UFS 3.1 host needs an HCE
+ * re-execute + DME link startup before the transfer request list can be taken
+ * over; the ABL leaves the clocks/PHY up but the naive take-over does not work
+ * there. */
+static inline bool
+sweet_board_sm6375(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("qcom,blair") ? 1 : 0;
+	}
+	return cached == 1;
+}
