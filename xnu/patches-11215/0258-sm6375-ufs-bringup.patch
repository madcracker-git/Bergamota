+/* ---- SM6375 UFS bring-up ---- */
+
+/*
+ * The SM6375 ABL leaves the host enabled with the UniPro link up (HCE=1,
+ * DP=1). Re-running HCE drops the link, so the QMP PHY must be re-powered and
+ * re-calibrated before the link can retrain. Sequence: HCE stop -> PHY GDSC +
+ * core reset -> UFS clocks -> PHY soft-reset + calibration -> SERDES ->
+ * HCE start -> DME link startup -> HS gear-up.
+ */
+#define SM6375_GCC		0x1400000UL
+#define SM6375_GCC_UFS_PHY_BCR	0x45000
+#define SM6375_GCC_UFS_PHY_GDSCR 0x45004
+#define SM6375_GCC_UFS_PHY_AXI_CLK 0x45010
+#define SM6375_GCC_UFS_PHY_AHB_CLK 0x45014
+#define SM6375_GCC_UFS_PHY_TX_SYM 0x45018
+#define SM6375_GCC_UFS_PHY_RX_SYM 0x4501c
+#define SM6375_GCC_UFS_PHY_AXI_SRC 0x45020
+#define SM6375_GCC_UFS_PHY_UNIPRO_CLK 0x45040
+#define SM6375_GCC_UFS_PHY_ICE_CLK 0x45044
+#define SM6375_GCC_UFS_PHY_ICE_SRC 0x45048
+#define SM6375_GCC_UFS_PHY_UNIPRO_SRC 0x45060
+#define SM6375_GCC_UFS_PHY_AUX_CLK 0x45078
+#define SM6375_GCC_UFS_PHY_AUX_SRC 0x4507c
+#define SM6375_GCC_SYS_NOC_UFS_AXI 0x45098
+#define SM6375_GCC_UFS_MEM_CLKREF 0x8c000
+#define SM6375_GCC_GPLL0_VOTE	0x79000
+
+#define SM6375_PHY		0x4807000UL
+#define SM6375_PHY_START	0xc00
+#define SM6375_PHY_SW_RESET	0xc08
+#define SM6375_PHY_PCS_READY	0xd80
+#define SM6375_RX0_IFACE_MODE	0x734
+
+#define REG_UIC_CMD		0x90
+#define REG_UIC_ARG1		0x94
+#define REG_UIC_ARG2		0x98
+#define REG_UIC_ARG3		0x9c
+#define REG_UFS_CFG1		0xDC
+
+#define HCS_UICRDY		(1u << 3)
+#define UIC_DME_LINK_STARTUP	0x16
+#define UIC_CMD_DME_SET		0x02
+#define IS_UIC_CMD_COMPL	(1u << 10)
+
+/* UniPro MIB attributes (JESD220, Linux include/ufs/unipro.h). */
+#define PA_ACTIVETXDATALANES	0x1560
+#define PA_TXGEAR		0x1568
+#define PA_TXTERMINATION	0x1569
+#define PA_HSSERIES		0x156A
+#define PA_PWRMODE		0x1571
+#define PA_ACTIVERXDATALANES	0x1580
+#define PA_RXGEAR		0x1583
+#define PA_RXTERMINATION	0x1584
+#define PA_HS_MODE_A		1
+
+/* Vendor phy_cal_table_rate_A_no_g4 (SM6375 non-G4, 1 lane). */
+static const uint16_t sm6375_phy_cal[][2] = {
+	{ 0xc04, 0x01 }, { 0x094, 0xd9 }, { 0x158, 0x11 }, { 0x15c, 0x00 }, { 0x0a4, 0x01 },
+	{ 0x10c, 0x02 }, { 0x058, 0x0f }, { 0x124, 0x00 }, { 0x1bc, 0x11 }, { 0x0bc, 0x82 },
+	{ 0x074, 0x06 }, { 0x07c, 0x16 }, { 0x084, 0x36 }, { 0x0ac, 0xff }, { 0x0b0, 0x0c },
+	{ 0x1ac, 0xac }, { 0x1b0, 0x1e }, { 0x0c4, 0x98 }, { 0x078, 0x06 }, { 0x080, 0x16 },
+	{ 0x088, 0x36 }, { 0x0b4, 0x32 }, { 0x0b8, 0x0f }, { 0x1b4, 0xdd }, { 0x1b8, 0x23 },
+	{ 0x4d8, 0x06 }, { 0x4dc, 0x03 }, { 0x4e0, 0x01 }, { 0x4e4, 0x00 }, { 0x484, 0x35 },
+	{ 0x4b8, 0x0c }, { 0x720, 0x24 }, { 0x71c, 0x0f }, { 0x724, 0x1e }, { 0x728, 0x18 },
+	{ 0x630, 0x0a }, { 0x634, 0x5a }, { 0x644, 0xf1 }, { 0x63c, 0x80 }, { 0x648, 0x80 },
+	{ 0x608, 0x0e }, { 0x614, 0x04 }, { 0x680, 0x1b }, { 0x6ec, 0x06 }, { 0x6f0, 0x04 },
+	{ 0x6f4, 0x1d }, { 0x714, 0x00 }, { 0x700, 0x10 }, { 0x6f8, 0xc0 }, { 0x6fc, 0x00 },
+	{ 0x770, 0x6d }, { 0x774, 0x6d }, { 0x778, 0xed }, { 0x77c, 0x3b }, { 0x780, 0x3c },
+	{ 0x784, 0xe0 }, { 0x788, 0xc8 }, { 0x78c, 0xc8 }, { 0x790, 0x3b }, { 0x794, 0xb1 },
+	{ 0x798, 0xe0 }, { 0x79c, 0xc8 }, { 0x7a0, 0xc8 }, { 0x7a4, 0x3b }, { 0x7a8, 0xb1 },
+	{ 0x7bc, 0x0c }, { 0xd58, 0x6d }, { 0xc30, 0x0a }, { 0xc38, 0x02 }, { 0xdd8, 0x43 },
+	{ 0xd24, 0x1f }, { 0xd50, 0xff }, { 0xc2c, 0x03 }, { 0xc0c, 0x16 }, { 0xc10, 0xd8 },
+	{ 0xd60, 0xaa }, { 0xd68, 0x06 }, { 0xc74, 0x03 }, { 0xcb4, 0x03 },
+};
+
+/* Polled UIC command (DME). Result code in REG_UIC_ARG2. */
+static int
+sm6375_uic_cmd(uint32_t cmd, uint32_t a1, uint32_t a2, uint32_t a3, uint32_t *res)
+{
+	uint64_t deadline;
+	ufs_wr(REG_IS, IS_UIC_CMD_COMPL);
+	ufs_wr(REG_UIC_ARG1, a1);
+	ufs_wr(REG_UIC_ARG2, a2);
+	ufs_wr(REG_UIC_ARG3, a3);
+	ufs_wr(REG_UIC_CMD, cmd);
+	nanoseconds_to_absolutetime(5ull * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	while (!(ufs_rd(REG_IS) & IS_UIC_CMD_COMPL)) {
+		if (mach_absolute_time() > deadline) {
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	*res = ufs_rd(REG_UIC_ARG2) & 0xff;
+	return 0;
+}
+
+static int
+sm6375_dme_set(uint32_t mib, uint32_t val)
+{
+	uint32_t res;
+	int rc = sm6375_uic_cmd(UIC_CMD_DME_SET, mib << 16, 0, val, &res);
+	if (rc) {
+		return rc;
+	}
+	return res == 0 ? 0 : EIO;
+}
+
+/* Gear the UniPro link up to HS-G1 FAST (ufshcd_dme_change_power_mode). */
+static int
+sm6375_ufs_gear_up(void)
+{
+	int rc;
+	if ((rc = sm6375_dme_set(PA_RXGEAR, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_ACTIVERXDATALANES, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_RXTERMINATION, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_TXGEAR, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_ACTIVETXDATALANES, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_TXTERMINATION, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_HSSERIES, PA_HS_MODE_A))) return rc;
+	if ((rc = sm6375_dme_set(PA_PWRMODE, (1u << 4) | 1u))) return rc;
+	return 0;
+}
+
+/* RCG2: source select (bits 10:8) + hid_div (bits 4:0 = 2*div - 1), then update
+ * + root enable. Poll CMD_UPDATE (bit 0) to clear; CMD_ROOT_EN (bit 1) stays set. */
+static void
+sm6375_rcg_set(volatile uint32_t *gcc, uint32_t cmd, unsigned src, unsigned hid_div)
+{
+	gcc[(cmd + 4) / 4] = (src << 8) | hid_div;
+	gcc[cmd / 4] = gcc[cmd / 4] | 1u | 2u;	/* CMD_UPDATE | CMD_ROOT_EN */
+	for (int i = 0; i < 2000; i++) {
+		if (!(gcc[cmd / 4] & 1u)) {		/* UPDATE clears when done */
+			return;
+		}
+		delay(5);
+	}
+}
+
+/* GCC branch clock on. Returns nothing; a poll timeout is logged but not fatal:
+ * the clock framework treats CLK_OFF(31)=0 OR NoC FSM(30:28)=2 as "on", and the
+ * symbol clocks (TX/RX lane sync) skip the halt check entirely. */
+static void
+sm6375_clk_on(volatile uint32_t *gcc, uint32_t off, int skip_halt)
+{
+	uint32_t v = gcc[off / 4];
+	if (!(v & 1u)) {
+		gcc[off / 4] = v | 1u;
+	}
+	if (skip_halt) {
+		return;
+	}
+	for (int i = 0; i < 2000; i++) {
+		v = gcc[off / 4];
+		if (!(v & (1u << 31)) || (((v >> 28) & 0x7) == 2)) {
+			return;
+		}
+		delay(5);
+	}
+}
+
+/*
+ * One device-management UPIU (NOP OUT or QUERY REQ) in slot 0. tc = transaction
+ * code; func = query function (0 for NOP); opcode/idn/value fill the query OSF.
+ * On success sets *upiu (response transaction code), *qresult (byte 6) and
+ * *qvalue (byte 23). No data transfer.
+ */
+static int
+sm6375_devmgmt(uint8_t tc, uint8_t func, uint8_t opcode, uint8_t idn, uint32_t value,
+    uint32_t *ocs_out, uint8_t *upiu_out, uint8_t *qresult_out, uint8_t *qvalue_out)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = tc;
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = func;
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = idn;
+	ucd->cmd[20] = (uint8_t)(value >> 24);
+	ucd->cmd[21] = (uint8_t)(value >> 16);
+	ucd->cmd[22] = (uint8_t)(value >> 8);
+	ucd->cmd[23] = (uint8_t)value;
+
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	utrd->prdt = 0;
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+
+	*ocs_out = utrd->dw2 & 0xff;
+	*upiu_out = ucd->resp[0];
+	*qresult_out = ucd->resp[6];
+	*qvalue_out = ucd->resp[23];
+	return 0;
+}
+
+/* NOP OUT (ufshcd_verify_dev_init): the device's UTP layer answers NOP IN. */
+static int
+sm6375_nop_out(void)
+{
+	uint32_t ocs; uint8_t upiu, qr, qv;
+	int rc = sm6375_devmgmt(0x00 /* NOP OUT */, 0, 0, 0, 0, &ocs, &upiu, &qr, &qv);
+	if (rc) {
+		return rc;
+	}
+	return (ocs == 0 && upiu == 0x20 /* NOP IN */) ? 0 : EIO;
+}
+
+/* Query request. func 0x01 = READ, 0x81 = WRITE; *val gets the value LSB. */
+static int
+sm6375_query(uint8_t func, uint8_t opcode, uint8_t idn, uint32_t value, uint8_t *val)
+{
+	uint32_t ocs; uint8_t upiu, qr, qv;
+	int rc = sm6375_devmgmt(0x16 /* QUERY REQ */, func, opcode, idn, value, &ocs, &upiu, &qr, &qv);
+	if (rc) {
+		return rc;
+	}
+	if (ocs || upiu != 0x36 /* QUERY RSP */ || qr != 0) {
+		return EIO;
+	}
+	if (val) {
+		*val = qv;
+	}
+	return 0;
+}
+
+/*
+ * Complete device init (ufshcd_complete_dev_init): SET fDeviceInit, then poll
+ * READ_FLAG until the device clears it. Requires the transfer list programmed
+ * (caller runs this after ufs_take_over_host).
+ */
+static int
+sm6375_fdevice_init(void)
+{
+	uint8_t fdi = 0;
+	int rc;
+	uint64_t deadline;
+
+	/* bRefClkFreq must be 0 (19.2 MHz) for the XO on this SoC. */
+	uint8_t rf = 0xff;
+	rc = sm6375_query(0x01 /* READ */, 0x03 /* READ_ATTR */, 0x0a /* bRefClkFreq */, 0, &rf);
+	if (rc == 0 && rf != 0) {
+		sm6375_query(0x81 /* WRITE */, 0x04 /* WRITE_ATTR */, 0x0a, 0, NULL);
+	}
+
+	rc = sm6375_query(0x01, 0x05 /* READ_FLAG */, 0x01 /* fDeviceInit */, 0, &fdi);
+	if (rc == 0 && fdi == 0) {
+		rc = sm6375_query(0x81, 0x06 /* SET_FLAG */, 0x01, 0, NULL);
+		if (rc) {
+			rc = 0;		/* already initialising is not fatal */
+		}
+	}
+	/* Poll READ_FLAG until the device clears it, up to 30 s (Linux FDEVICEINIT
+	 * timeout). XNU's delay() is in MICROseconds, so 100 ms = delay(100000). */
+	nanoseconds_to_absolutetime(30ull * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	for (;;) {
+		if (rc) {
+			break;
+		}
+		rc = sm6375_query(0x01, 0x05, 0x01, 0, &fdi);
+		if (rc || !fdi) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			rc = ETIMEDOUT;
+			break;
+		}
+		delay(100000);		/* 100 ms */
+	}
+	return rc;
+}
+
+static int
+sm6375_ufs_bringup(void)
+{
+	volatile uint32_t *gcc = (volatile uint32_t *)ml_io_map(SM6375_GCC, 0x100000);
+	volatile uint32_t *phy = (volatile uint32_t *)ml_io_map(SM6375_PHY, 0x2000);
+	uint32_t res;
+	int rc;
+
+	/* Polled driver: never drive the interrupt line. */
+	ufs_wr(REG_IE, 0);
+
+	/* 1. HCE stop (ufshcd_hba_stop): the PHY then needs re-calibration. */
+	ufs_wr(REG_HCE, 0);
+	delay(1000);
+
+	/* 2. PHY power domain (ufs_phy_gdsc): clear SW_COLLAPSE, wait PWR_ON. */
+	gcc[SM6375_GCC_UFS_PHY_GDSCR / 4] &= ~1u;
+	for (int i = 0; i < 2000 && !(gcc[SM6375_GCC_UFS_PHY_GDSCR / 4] & (1u << 31)); i++) {
+		delay(5);
+	}
+
+	/* 3. Core reset (ufs_qcom_host_reset). */
+	gcc[SM6375_GCC_UFS_PHY_BCR / 4] |= 1u;
+	delay(200);
+	gcc[SM6375_GCC_UFS_PHY_BCR / 4] &= ~1u;
+	delay(1000);
+
+	/* 4. Vote GPLL0 (the parent PLL of the UFS RCGs) and bring up the clocks. */
+	gcc[SM6375_GCC_GPLL0_VOTE / 4] |= 1u;
+	sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_AXI_SRC, 4, 3);		/* 100 MHz */
+	sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_UNIPRO_SRC, 2, 7);		/* 75 MHz */
+	sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_ICE_SRC, 2, 3);		/* 150 MHz */
+	sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_AUX_SRC, 0, 1);		/* 19.2 MHz */
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_AHB_CLK, 0);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_AXI_CLK, 0);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_UNIPRO_CLK, 0);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_ICE_CLK, 0);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_AUX_CLK, 0);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_TX_SYM, 1);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_RX_SYM, 1);
+	sm6375_clk_on(gcc, SM6375_GCC_SYS_NOC_UFS_AXI, 0);
+	sm6375_clk_on(gcc, SM6375_GCC_UFS_MEM_CLKREF, 0);
+
+	/* 5. PHY soft-reset + calibration. */
+	ufs_wr(REG_UFS_CFG1, ufs_rd(REG_UFS_CFG1) | (1u << 1));
+	phy[SM6375_PHY_SW_RESET / 4] = 0x01;
+	phy[SM6375_RX0_IFACE_MODE / 4] &= ~(1u << 5);
+	for (unsigned k = 0; k < sizeof(sm6375_phy_cal) / sizeof(sm6375_phy_cal[0]); k++) {
+		phy[sm6375_phy_cal[k][0] / 4] = sm6375_phy_cal[k][1];
+	}
+	phy[SM6375_PHY_SW_RESET / 4] = 0x00;
+	ufs_wr(REG_UFS_CFG1, ufs_rd(REG_UFS_CFG1) & ~(1u << 1));
+	ufs_rd(REG_UFS_CFG1);
+	delay(1000);
+
+	/* 6. Start the SERDES, wait for PCS_READY. */
+	phy[SM6375_PHY_START / 4] = 0x01;
+	for (int i = 0; i < 2000 && !(phy[SM6375_PHY_PCS_READY / 4] & 1); i++) {
+		delay(500);
+	}
+	if (!(phy[SM6375_PHY_PCS_READY / 4] & 1)) {
+		panic("sm6375 ufs: PHY PCS_READY never asserted (gdsc 0x%x)", gcc[SM6375_GCC_UFS_PHY_GDSCR / 4]);
+	}
+
+	/* 7. HCE start + UICRDY (ufshcd_hba_start). */
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 2000 && !(ufs_rd(REG_HCE) & 1); i++) {
+		delay(50);
+	}
+	if (!(ufs_rd(REG_HCE) & 1)) {
+		panic("sm6375 ufs: HCE did not assert");
+	}
+	for (int i = 0; i < 2000 && !(ufs_rd(REG_HCS) & HCS_UICRDY); i++) {
+		delay(50);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_UICRDY)) {
+		panic("sm6375 ufs: UICRDY never asserted (hcs 0x%x)", ufs_rd(REG_HCS));
+	}
+
+	/* 8. DME link startup (ufshcd_dme_link_startup). */
+	rc = sm6375_uic_cmd(UIC_DME_LINK_STARTUP, 0, 0, 0, &res);
+	if (rc) {
+		panic("sm6375 ufs: DME link startup failed (rc %d is 0x%x)", rc, ufs_rd(REG_IS));
+	}
+	if (res != 0) {
+		panic("sm6375 ufs: DME link startup result 0x%x", res);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_DP)) {
+		panic("sm6375 ufs: no device present after link startup (hcs 0x%x)", ufs_rd(REG_HCS));
+	}
+
+	return 0;
+}
