+/* ---- SM6375 UFS full bring-up (qcom,ufs-phy-qmp-v4-yupik) ---- */
+
+/*
+ * The SM6375 ABL does not leave the UFS host in a state the naive take-over
+ * below can reuse (the UTRLBA reprogram never sticks). Re-run the full
+ * Qualcomm sequence (GCC clocks, GDSC, core reset, QMP PHY calibration,
+ * HCE re-execute, DME link startup, HS gear-up) exactly as the Enxerto
+ * bootloader does (enxerto/ufs.c), but here in the kernel where the
+ * scheduler is already up.
+ */
+#define SM6375_GCC		0x1400000UL
+#define SM6375_GCC_UFS_PHY_BCR	0x45000
+#define SM6375_GCC_UFS_PHY_GDSCR 0x45004
+#define SM6375_GCC_UFS_PHY_AXI_CLK 0x45010
+#define SM6375_GCC_UFS_PHY_AHB_CLK 0x45014
+#define SM6375_GCC_UFS_PHY_TX_SYM 0x45018
+#define SM6375_GCC_UFS_PHY_RX_SYM 0x4501c
+#define SM6375_GCC_UFS_PHY_AXI_SRC 0x45020
+#define SM6375_GCC_UFS_PHY_UNIPRO_CLK 0x45040
+#define SM6375_GCC_UFS_PHY_ICE_CLK 0x45044
+#define SM6375_GCC_UFS_PHY_ICE_SRC 0x45048
+#define SM6375_GCC_UFS_PHY_UNIPRO_SRC 0x45060
+#define SM6375_GCC_UFS_PHY_AUX_CLK 0x45078
+#define SM6375_GCC_UFS_PHY_AUX_SRC 0x4507c
+#define SM6375_GCC_SYS_NOC_UFS_AXI 0x45098
+#define SM6375_GCC_UFS_MEM_CLKREF 0x8c000
+
+#define SM6375_PHY		0x4807000UL
+#define SM6375_PHY_START	0xc00
+#define SM6375_PHY_SW_RESET	0xc08
+#define SM6375_PHY_PCS_READY	0xd80
+#define SM6375_RX0_IFACE_MODE	0x734	/* QSERDES_RX0_RX_INTERFACE_MODE */
+
+#define REG_UIC_CMD		0x90
+#define REG_UIC_ARG1		0x94
+#define REG_UIC_ARG2		0x98
+#define REG_UIC_ARG3		0x9c
+#define REG_UFS_CFG1		0xDC
+
+#define HCS_UICRDY		(1u << 3)
+#define UIC_DME_LINK_STARTUP	0x16
+#define UIC_CMD_DME_SET		0x02
+#define IS_UIC_CMD_COMPL	(1u << 10)
+
+/* UniPro MIB attributes (JESD220, Linux include/ufs/unipro.h). */
+#define PA_ACTIVETXDATALANES	0x1560
+#define PA_TXGEAR		0x1568
+#define PA_TXTERMINATION	0x1569
+#define PA_HSSERIES		0x156A
+#define PA_PWRMODE		0x1571
+#define PA_ACTIVERXDATALANES	0x1580
+#define PA_RXGEAR		0x1583
+#define PA_RXTERMINATION	0x1584
+#define PA_HS_MODE_A		1
+
+/* Vendor phy_cal_table_rate_A_no_g4 (SM6375 non-G4, 1 lane). */
+static const uint16_t sm6375_phy_cal[][2] = {
+	{ 0xc04, 0x01 }, { 0x094, 0xd9 }, { 0x158, 0x11 }, { 0x15c, 0x00 }, { 0x0a4, 0x01 },
+	{ 0x10c, 0x02 }, { 0x058, 0x0f }, { 0x124, 0x00 }, { 0x1bc, 0x11 }, { 0x0bc, 0x82 },
+	{ 0x074, 0x06 }, { 0x07c, 0x16 }, { 0x084, 0x36 }, { 0x0ac, 0xff }, { 0x0b0, 0x0c },
+	{ 0x1ac, 0xac }, { 0x1b0, 0x1e }, { 0x0c4, 0x98 }, { 0x078, 0x06 }, { 0x080, 0x16 },
+	{ 0x088, 0x36 }, { 0x0b4, 0x32 }, { 0x0b8, 0x0f }, { 0x1b4, 0xdd }, { 0x1b8, 0x23 },
+	{ 0x4d8, 0x06 }, { 0x4dc, 0x03 }, { 0x4e0, 0x01 }, { 0x4e4, 0x00 }, { 0x484, 0x35 },
+	{ 0x4b8, 0x0c }, { 0x720, 0x24 }, { 0x71c, 0x0f }, { 0x724, 0x1e }, { 0x728, 0x18 },
+	{ 0x630, 0x0a }, { 0x634, 0x5a }, { 0x644, 0xf1 }, { 0x63c, 0x80 }, { 0x648, 0x80 },
+	{ 0x608, 0x0e }, { 0x614, 0x04 }, { 0x680, 0x1b }, { 0x6ec, 0x06 }, { 0x6f0, 0x04 },
+	{ 0x6f4, 0x1d }, { 0x714, 0x00 }, { 0x700, 0x10 }, { 0x6f8, 0xc0 }, { 0x6fc, 0x00 },
+	{ 0x770, 0x6d }, { 0x774, 0x6d }, { 0x778, 0xed }, { 0x77c, 0x3b }, { 0x780, 0x3c },
+	{ 0x784, 0xe0 }, { 0x788, 0xc8 }, { 0x78c, 0xc8 }, { 0x790, 0x3b }, { 0x794, 0xb1 },
+	{ 0x798, 0xe0 }, { 0x79c, 0xc8 }, { 0x7a0, 0xc8 }, { 0x7a4, 0x3b }, { 0x7a8, 0xb1 },
+	{ 0x7bc, 0x0c }, { 0xd58, 0x6d }, { 0xc30, 0x0a }, { 0xc38, 0x02 }, { 0xdd8, 0x43 },
+	{ 0xd24, 0x1f }, { 0xd50, 0xff }, { 0xc2c, 0x03 }, { 0xc0c, 0x16 }, { 0xc10, 0xd8 },
+	{ 0xd60, 0xaa }, { 0xd68, 0x06 }, { 0xc74, 0x03 }, { 0xcb4, 0x03 },
+};
+
+static volatile uint32_t *
+sm6375_gcc(void)
+{
+	/* The GCC UFS PHY clocks live at offsets up to 0x8c000 (gcc_ufs_mem_clkref),
+	 * so the whole 1 MiB clock-controller block must be mapped. */
+	return (volatile uint32_t *)ml_io_map(SM6375_GCC, 0x100000);
+}
+
+static volatile uint32_t *
+sm6375_phy(void)
+{
+	return (volatile uint32_t *)ml_io_map(SM6375_PHY, 0x2000);
+}
+
+/* Microsecond busy-wait on the arch counter (the same as Enxerto's udelay).
+ * XNU's delay() may block on the boot thread during vfs_mountroot, which is
+ * wrong here; the counter is always running once the timebase is up. */
+static void
+sm6375_udelay(unsigned us)
+{
+	uint64_t f, t, end;
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
+	__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(t));
+	end = t + f / 1000000 * us;
+	do {
+		__asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(t));
+	} while (t < end);
+}
+
+/* GCC branch clock on: set BIT(0), poll CLK_OFF (bit 31) clear OR the NoC FSM
+ * status (bits 30:28) == 2 (Linux clk_branch2_check_halt: FSM_STATUS_ON). The
+ * branch2 clocks with a parent RCG can keep CLK_OFF set while the FSM has
+ * latched ON, so bit 31 alone wrongly reports "off". */
+static int
+sm6375_clk_on(volatile uint32_t *gcc, uint32_t off)
+{
+	uint32_t v = gcc[off / 4];
+	if (!(v & 1u)) {
+		gcc[off / 4] = v | 1u;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	for (int i = 0; i < 2000; i++) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		v = gcc[off / 4];
+		if (!(v & (1u << 31)) || (((v >> 28) & 0x7) == 2)) {
+			return 0;
+		}
+		sm6375_udelay(5);
+	}
+	return -1;
+}
+
+/* RCG2: source select (bits 10:8) + hid_div (bits 4:0 = 2*div - 1), then update + root enable. */
+static int
+sm6375_rcg_set(volatile uint32_t *gcc, uint32_t cmd, unsigned src, unsigned hid_div)
+{
+	gcc[(cmd + 4) / 4] = (src << 8) | hid_div;
+	__asm__ volatile("dsb sy" ::: "memory");
+	gcc[cmd / 4] = gcc[cmd / 4] | 1u | 2u;
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (int i = 0; i < 2000; i++) {
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (!(gcc[cmd / 4] & 2u)) {
+			return 0;
+		}
+		sm6375_udelay(5);
+	}
+	return -1;
+}
+
+/* Polled UIC command (DME). Result code in REG_UIC_ARG2. */
+static int
+sm6375_uic_cmd(uint32_t cmd, uint32_t a1, uint32_t a2, uint32_t a3, uint32_t *res)
+{
+	ufs_wr(REG_IS, IS_UIC_CMD_COMPL);	/* ack any stale completion */
+	ufs_wr(REG_UIC_ARG1, a1);
+	ufs_wr(REG_UIC_ARG2, a2);
+	ufs_wr(REG_UIC_ARG3, a3);
+	ufs_wr(REG_UIC_CMD, cmd);
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(5ull * NSEC_PER_SEC, &deadline);
+	deadline += mach_absolute_time();
+	while (!(ufs_rd(REG_IS) & IS_UIC_CMD_COMPL)) {
+		if (mach_absolute_time() > deadline) {
+			return ETIMEDOUT;
+		}
+		sm6375_udelay(1);
+	}
+	*res = ufs_rd(REG_UIC_ARG2) & 0xff;
+	return 0;
+}
+
+static int
+sm6375_dme_set(uint32_t mib, uint32_t val)
+{
+	uint32_t res;
+	int rc = sm6375_uic_cmd(UIC_CMD_DME_SET, mib << 16, 0, val, &res);
+	if (rc) {
+		return rc;
+	}
+	return res == 0 ? 0 : EIO;
+}
+
+/* Gear the UniPro link up to HS-G1 FAST mode (ufshcd_dme_change_power_mode). */
+static int
+sm6375_ufs_gear_up(void)
+{
+	int rc;
+	if ((rc = sm6375_dme_set(PA_RXGEAR, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_ACTIVERXDATALANES, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_RXTERMINATION, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_TXGEAR, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_ACTIVETXDATALANES, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_TXTERMINATION, 1))) return rc;
+	if ((rc = sm6375_dme_set(PA_HSSERIES, PA_HS_MODE_A))) return rc;
+	if ((rc = sm6375_dme_set(PA_PWRMODE, (1u << 4) | 1u))) return rc;	/* FAST<<4 | FAST */
+	return 0;
+}
+
+/*
+ * Full SM6375 UFS bring-up. Returns 0 on success or an errno. The host
+ * controller (su.regs) is left enabled with the UniPro link up and the HS-G1
+ * gear selected; the caller then takes over the transfer request list.
+ */
+static int
+sm6375_ufs_bringup(void)
+{
+	volatile uint32_t *gcc = sm6375_gcc();
+	volatile uint32_t *phy = sm6375_phy();
+	int rc = 0;
+	unsigned bad = 0;
+
+	/* 1. Stop the controller before resetting its PHY/core (ufshcd_hba_stop). */
+	ufs_wr(REG_IE, 0);	/* polled driver: never drive the interrupt line */
+	ufs_wr(REG_HCE, 0);
+	sm6375_udelay(1000);
+
+	/* 2. Power the PHY domain (ufs_phy_gdsc): clear SW_COLLAPSE, wait PWR_ON. */
+	uint32_t g = gcc[SM6375_GCC_UFS_PHY_GDSCR / 4];
+	gcc[SM6375_GCC_UFS_PHY_GDSCR / 4] = g & ~1u;
+	for (int i = 0; i < 2000 && !(gcc[SM6375_GCC_UFS_PHY_GDSCR / 4] & (1u << 31)); i++) {
+		sm6375_udelay(5);
+	}
+
+	/* 3. Core reset (ufs_qcom_host_reset). */
+	gcc[SM6375_GCC_UFS_PHY_BCR / 4] |= 1u;
+	sm6375_udelay(200);
+	gcc[SM6375_GCC_UFS_PHY_BCR / 4] &= ~1u;
+	sm6375_udelay(1000);
+
+	/* 4. RCG sources. */
+	bad |= !sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_AXI_SRC, 4, 3) << 0;	/* 100 MHz */
+	bad |= !sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_UNIPRO_SRC, 2, 7) << 1;	/* 75 MHz */
+	bad |= !sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_ICE_SRC, 2, 3) << 2;	/* 150 MHz */
+	bad |= !sm6375_rcg_set(gcc, SM6375_GCC_UFS_PHY_AUX_SRC, 0, 1) << 3;	/* 19.2 MHz */
+
+	/* 5. Branch clocks. */
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_AHB_CLK) << 4;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_AXI_CLK) << 5;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_UNIPRO_CLK) << 6;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_ICE_CLK) << 7;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_AUX_CLK) << 8;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_TX_SYM) << 9;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_PHY_RX_SYM) << 10;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_SYS_NOC_UFS_AXI) << 11;
+	bad |= !sm6375_clk_on(gcc, SM6375_GCC_UFS_MEM_CLKREF) << 12;
+	if (bad) {
+		panic("sm6375 ufs: clock failures 0x%x; gdscr 0x%x axi 0x%x unipro 0x%x ice 0x%x aux 0x%x noc 0x%x ref 0x%x axi_rcg 0x%x cfg 0x%x gpll0_status 0x%x",
+		    bad,
+		    gcc[SM6375_GCC_UFS_PHY_GDSCR / 4],
+		    gcc[SM6375_GCC_UFS_PHY_AXI_CLK / 4],
+		    gcc[SM6375_GCC_UFS_PHY_UNIPRO_CLK / 4],
+		    gcc[SM6375_GCC_UFS_PHY_ICE_CLK / 4],
+		    gcc[SM6375_GCC_UFS_PHY_AUX_CLK / 4],
+		    gcc[SM6375_GCC_SYS_NOC_UFS_AXI / 4],
+		    gcc[SM6375_GCC_UFS_MEM_CLKREF / 4],
+		    gcc[SM6375_GCC_UFS_PHY_AXI_SRC / 4],
+		    gcc[(SM6375_GCC_UFS_PHY_AXI_SRC + 4) / 4],
+		    gcc[0x24 / 4]);
+	}
+
+	/* 6. PHY soft-reset + calibration. */
+	ufs_wr(REG_UFS_CFG1, ufs_rd(REG_UFS_CFG1) | (1u << 1));	/* UFS_PHY_SOFT_RESET */
+	phy[SM6375_PHY_SW_RESET / 4] = 0x01;
+	phy[SM6375_RX0_IFACE_MODE / 4] &= ~(1u << 5);		/* power_control: clear CLOCK_EDGE */
+	for (unsigned k = 0; k < sizeof(sm6375_phy_cal) / sizeof(sm6375_phy_cal[0]); k++) {
+		phy[sm6375_phy_cal[k][0] / 4] = sm6375_phy_cal[k][1];
+	}
+	phy[SM6375_PHY_SW_RESET / 4] = 0x00;
+	ufs_wr(REG_UFS_CFG1, ufs_rd(REG_UFS_CFG1) & ~(1u << 1));
+	ufs_rd(REG_UFS_CFG1);
+	sm6375_udelay(1000);
+
+	/* 7. Start the SERDES, wait for PCS_READY. */
+	phy[SM6375_PHY_START / 4] = 0x01;
+	for (int i = 0; i < 2000 && !(phy[SM6375_PHY_PCS_READY / 4] & 1); i++) {
+		sm6375_udelay(500);
+	}
+	if (!(phy[SM6375_PHY_PCS_READY / 4] & 1)) {
+		panic("sm6375 ufs: PHY PCS_READY never asserted");
+	}
+
+	/* 8. HCE start + UICRDY. */
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 2000 && !(ufs_rd(REG_HCE) & 1); i++) {
+		sm6375_udelay(50);
+	}
+	if (!(ufs_rd(REG_HCE) & 1)) {
+		panic("sm6375 ufs: HCE did not assert");
+	}
+	for (int i = 0; i < 2000 && !(ufs_rd(REG_HCS) & HCS_UICRDY); i++) {
+		sm6375_udelay(50);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_UICRDY)) {
+		panic("sm6375 ufs: UICRDY never asserted (hcs 0x%x)", ufs_rd(REG_HCS));
+	}
+
+	/* 9. DME link startup. */
+	uint32_t res;
+	rc = sm6375_uic_cmd(UIC_DME_LINK_STARTUP, 0, 0, 0, &res);
+	if (rc || res != 0) {
+		panic("sm6375 ufs: DME link startup failed (rc %d res 0x%x)", rc, res);
+	}
+	if (!(ufs_rd(REG_HCS) & HCS_DP)) {
+		panic("sm6375 ufs: link up but no device present (hcs 0x%x)", ufs_rd(REG_HCS));
+	}
+
+	/* 10. Gear up to HS-G1 FAST. */
+	rc = sm6375_ufs_gear_up();
+	if (rc) {
+		panic("sm6375 ufs: gear-up failed (%d)", rc);
+	}
+
+	return 0;
+}
